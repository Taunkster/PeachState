# FortyGuard API Key (get from FortyGuard admin console)
# FG_API_KEY=your_api_key_here

# Data source mode: fixtures | live | hybrid (default: fixtures)
# DATA_SOURCE=fixtures

# Database path (default: data/coolchain.db)
# PCS_DB_PATH=data/coolchain.db

# Streamlit settings
# STREAMLIT_SERVER_HEADLESS=true
# STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
